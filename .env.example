# Copy to .env and fill in. .env is gitignored; this file is the committed template.
# Every variable here is read exactly once, in app/settings.py. No os.getenv() anywhere else.

# --- LLM ---------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Default model for the agent loop. Do not downgrade to save cost without logging
# a decision — see docs/decisions.md.
AGENTFORGE_MODEL=claude-opus-5
# Cheap model for LLM-as-judge and low-stakes sub-agents.
AGENTFORGE_JUDGE_MODEL=claude-haiku-4-5
# low | medium | high | xhigh | max  — controls thinking depth and token spend.
AGENTFORGE_EFFORT=medium

# --- Run limits (hard ceilings; the loop refuses to exceed them) --------------
AGENTFORGE_MAX_STEPS=12
AGENTFORGE_STEP_TIMEOUT_SECONDS=60
AGENTFORGE_RUN_TOKEN_BUDGET=120000
AGENTFORGE_MAX_TOOL_RETRIES=2

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge
POSTGRES_DB=agentforge
# asyncpg driver for the API; psycopg for the (sync) Celery workers.
DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@postgres:5432/agentforge
DATABASE_URL_SYNC=postgresql+psycopg://agentforge:agentforge@postgres:5432/agentforge

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Run-event stream retention. A reconnecting SSE client replays from here, so this
# is the hard limit on how long a client can be disconnected and still catch up.
AGENTFORGE_EVENT_STREAM_MAXLEN=10000
AGENTFORGE_EVENT_STREAM_TTL_SECONDS=3600

# --- Retrieval ---------------------------------------------------------------
AGENTFORGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AGENTFORGE_EMBEDDING_DIM=384
AGENTFORGE_RERANKER_MODEL=BAAI/bge-reranker-base
AGENTFORGE_RETRIEVE_TOP_K=50
AGENTFORGE_RERANK_TOP_N=8
AGENTFORGE_RRF_K=60

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
